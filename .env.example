NODE_ENV=development
PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/akash_assistant

# Public/hosting links (make frontend-backend linking production-ready)
BACKEND_PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
ADMIN_DASHBOARD_URL=http://localhost:3000/admin
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

JWT_SECRET=replace-with-strong-jwt-secret
JWT_EXPIRES_IN=7d

EVOLUTION_BASE_URL=https://your-evolution-api-domain.com
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE=your-instance-name
EVOLUTION_WEBHOOK_SECRET=change-me
# Optional override, otherwise derived from BACKEND_PUBLIC_URL
EVOLUTION_WEBHOOK_URL=http://localhost:8080/api/webhooks/evolution

OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Broadcast/mass-message automation defaults
BROADCAST_DEFAULT_TITLE=Special Offer for You
BROADCAST_DEFAULT_OFFER_TEXT=Hi! We have exciting offers for you.
BROADCAST_PRODUCT_LINKS=https://yourstore.com/product-1,https://yourstore.com/product-2
BROADCAST_DELAY_MS=300
BROADCAST_MAX_RECIPIENTS=500

ADMIN_ALERT_EMAIL=admin@example.com
ADMIN_ALERT_WEBHOOK=https://dashboard-or-slack-webhook

ASSISTANT_GREETING=Hey! I am your assistant. How can I help you today?
HUMAN_HANDOFF_KEYWORDS=human,agent,representative,call me,customer support
AI_CONTEXT_MAX_MESSAGES=12
